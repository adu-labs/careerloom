# Process environment is the source of truth; this file is documentation only.
# Local defaults are intentionally loopback-only. APP_ENV is required outside local runs.
APP_ENV=development
API_HOST=127.0.0.1
API_PORT=3001

# Web 服务端专用；不使用 NEXT_PUBLIC_ 前缀，也不把地址传给浏览器。
# next dev 可省略（默认下列地址）；next start 必须显式设置。
# 只接受 http(s) origin，不允许路径、查询参数或嵌入凭证。
API_ORIGIN=http://127.0.0.1:3001
