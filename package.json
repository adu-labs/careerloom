{
  "name": "careerloom",
  "version": "0.0.0",
  "private": true,
  "license": "UNLICENSED",
  "workspaces": ["apps/api", "apps/web"],
  "engines": {"node": ">=24.14.0 <25"},
  "scripts": {
    "build": "npm run build --workspaces",
    "typecheck": "npm run typecheck --workspaces",
